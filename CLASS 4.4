class Gadget:
    def __init__(self, name, price):
        self.name = name
        self.price = price
    def show(self):
        print("Device", self.name, "Price:", self.price)
        print()
print("First Gadget")
iPAD = Gadget("Ipad", 599)
iPAD.show()

print ("Second Gadget")
iPHONE = Gadget("Iphone", 499)
iPHONE.show()

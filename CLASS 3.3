class Object:
    def __init__(self, name, price):
        self.name = name 
        self.price = price
    def display(self):
     print("First Object:", self.name)
     print("First Price:", self.price)
     print()
object1 = Object("Pencil", 27)
object2 = Object("Pen", 40)

object1.display()
object2.display()

class Archer(Character): #Child/Derived Class
    def __init__(self, health, speed, damage, armour):
        super().__init__(health, speed, damage, armour)
        self.resistance = 0
    def take_damage(self, amount):
        modified_amount = amount * self.resistance
        super().take_damage(modified_amount)


class Character: #Parent/Base Class
    def __init__(self, health, speed, damage, armour):
        self.health = health
        self.speed = speed
        self.damage = damage
        self.armour = armour

    def take_damage(self, amount):
        self.health -= amount

class Warrior(Character): #Child/Derived Class
    def __init__(self, health, speed, damage, armour):
        super().__init__(health, speed, damage, armour)
        self.resistance = 0.40
    def take_damage(self, amount):
        modified_amount = amount * self.resistance
        super().take_damage(modified_amount)

class Mage(Character): #Child/Derived Class
    def __init__(self, health, speed, damage, armour):
        super().__init__(health, speed, damage, armour)
        self.resistance = 0.20
    def take_damage(self, amount):
        modified_amount = amount * self.resistance
        super().take_damage(modified_amount)

class Tank(Character): #Child/Derived Class
    def __init__(self, health, speed, damage, armour):
        super().__init__(health, speed, damage, armour)

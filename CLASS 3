class Person:
    def __init__(self, name, age):
        self.name = name
        self.age = age
    
    def display(self):
        print ("My name is", self.name)
        print ("I am", self.age, "years old")
        print()

person1 = Person("Zai", 17)
person2 = Person("Lily", 15)
person3 = Person("Daisy", 19)

person1.display()
person2.display()
person3.display()

class Circle:
    pi = 3.14

    def __init__(self, radius):
        self.radius = radius
    def calculate_area(self):
        print(self.pi*self.radius*self.radius)

class Rectangle:
    def __init__(self, length, width):
        self.length = length
        self.width = width
    def calculate_area(self):
        print(self.length*self.width)

#main function
def area(self):
    self.calculate_area()

c=Circle(5)
r=Rectangle(10, 5)

#call the function
area(c)
area(r)


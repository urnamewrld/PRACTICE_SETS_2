class Book:
    def __init__(self, title, author, price):
        self.title = title
        self.author = author
        self.price = price
        
    def __repr__(self):
        return f"Title of Book: {self.title}, Author: {self.author}, Price: {self.price}"
        print()
        
Book1 = Book("Harry Potter", "J.K. Rowling", 30)
Book2 = Book("Wizard of Oz", "L. Frank Baum", 40)

print(Book1)
print()
